// Valid MiniLang Test Program
// Demonstrates: variable declarations, assignments, arithmetic, while loop, if/else, and print.
// Expected Output:
// 15
// 115

int sum = 0;
int i = 1;

while (i <= 5) {
    sum = sum + i;
    i = i + 1;
}

print(sum);

if (sum >= 15) {
    int bonus = 100;
    print(sum + bonus);
} else {
    print(0);
}
